Output assets/demo-hashsleuth.svg

Set FontSize 15
Set Width 860
Set Height 340
Set Padding 14
Set Shell bash
Set Theme { "name": "externum", "black": "#0d1117", "red": "#f85149", "green": "#3fb950", "yellow": "#e3b341", "blue": "#58a6ff", "magenta": "#a371f7", "cyan": "#39c5cf", "white": "#e6edf3", "brightBlack": "#8b949e" }

Type 'hashsleuth identify 5f4dcc3b5aa765d61d8327deb882cf99'
Enter
Sleep 1200ms

Type 'hashsleuth brute 5d41402abc4b2a76b9719d911017c592 abc 4'
Enter
Sleep 2500ms
Sleep 1500ms
